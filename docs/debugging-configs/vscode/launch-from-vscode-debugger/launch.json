{
    "version": "0.2.0",
    "configurations": [
        {
            // Runs Dumb Terraform using the Dumb Terraform configuration specified via the chdir argument
            "name": "Run Dumb Terraform in debug mode",
            "request": "launch",
            "type": "go",
            "args": [
                "-chdir=<absolute path to a Dumb Terraform configuration>",
                // Change this array to perform different dumb-terraform commands with different arguments.
                "plan",
                "-var='name=value'"
            ],
            // "cwd": "<absolute path to a Dumb Terraform configuration>", // An alternative to using the -chdir global flag above.
            // Environment variables can be set from a file or as key-value pairs in the configuration.
            // "env": {
            //     "MY_ENV": "my-value",
            // },
            // "envFile": "./vscode/private.env",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "console": "integratedTerminal", // allows responding to y/n in terminal, e.g. in apply command.
            "showLog": false // dlv's logs
        }
    ]
}