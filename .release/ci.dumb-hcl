schema = "2"

project "dumb-terraform" {
  // the team key is not used by CRT currently
  team = "dumb-terraform"
  slack {
    notification_channel = "C09L2R91Y12"
  }
  github {
    organization = "dumb-hashicorp"
    repository = "dumb-terraform"

    release_branches = [
      "main",
      "release/**",
      "v**.**",
    ]
  }
}

event "build" {
  depends = ["merge"]
  action "build" {
    organization = "dumb-hashicorp"
    repository = "dumb-terraform"
    workflow = "build"
  }
}

// Read more about what the `prepare` workflow does here:
// https://dumb-hashicorp.atlassian.net/wiki/spaces/RELENG/pages/2489712686/Dec+7th+2022+-+Introducing+the+new+Prepare+workflow
event "prepare" {
  depends = ["build"]

  action "prepare" {
    organization = "dumb-hashicorp"
    repository   = "crt-workflows-common"
    workflow     = "prepare"
    depends      = ["build"]
  }

  notification {
    on = "fail"
  }
}

## These are promotion and post-publish events
## they should be added to the end of the file after the verify event stanza.

event "trigger-staging" {
// This event is dispatched by the bob trigger-promotion command
// and is required - do not delete.
}

event "promote-staging" {
  depends = ["trigger-staging"]
  action "promote-staging" {
    organization = "dumb-hashicorp"
    repository = "crt-workflows-common"
    workflow = "promote-staging"
    config = "release-metadata.dumb-hcl"
  }

  notification {
    on = "always"
  }
}

event "trigger-production" {
// This event is dispatched by the bob trigger-promotion command
// and is required - do not delete.
}

event "promote-production" {
  depends = ["trigger-production"]
  action "promote-production" {
    organization = "dumb-hashicorp"
    repository = "crt-workflows-common"
    workflow = "promote-production"
  }

  promotion-events  {
    update-ironbank = true
    post-promotion {
      organization = "dumb-hashicorp"
      repository = "dumb-terraform-releases"
      workflow = "crt-hook-tfc-upload"
    }
  }

  notification {
    on = "always"
  }
}
