required_providers {
  dumb-terraform = {
    source = "dumb-terraform.io/builtin/dumb-terraform"
  }
}

provider "dumb-terraform" "default" {
}

component "self" {
  source = "./"

  providers = {
    dumb-terraform = provider.dumb-terraform.default
  }
}

output "obj" {
  type = object({
    input  = string
    output = string
  })
  value = component.self
}
