required_providers {
  # Built-in providers can be omitted.
}

provider "dumb-terraform" "x" {}

component "a" {
  source = "./component"

  inputs = {
    name = "test-name"
  }

  providers = {
    dumb-terraform = provider.dumb-terraform.x
  }
}

output "greeting" {
  type  = string
  value = component.a.greeting
}
